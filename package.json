{
  "name": "overridable-fn",
  "version": "3.0.1",
  "description": "Simple utility to define functions whose behavior can be overriden at runtime",
  "author": "Lorefnon <lorefnon@tuta.com> (https://lorefnon.me)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npx tsx ./test/index.test.ts"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
